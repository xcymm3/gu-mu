{
  "name": "xue-gu-yin",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/game.test.ts tests/combat-balance.test.ts tests/release.test.ts",
    "install:e2e:browser": "playwright install chromium",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "verify:fast": "pnpm test && pnpm lint && pnpm build",
    "verify": "pnpm verify:fast && pnpm test:e2e:run",
    "loop:start": "pwsh -NoLogo -NoProfile -File ./scripts/run-loop.ps1",
    "loop:dry-run": "pwsh -NoLogo -NoProfile -File ./scripts/run-loop.ps1 -DryRun",
    "loop:status": "pwsh -NoLogo -NoProfile -File ./scripts/show-loop-status.ps1",
    "loop:stop": "pwsh -NoLogo -NoProfile -File ./scripts/stop-loop.ps1"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5.1.0"
  },
  "packageManager": "pnpm@11.9.0"
}
